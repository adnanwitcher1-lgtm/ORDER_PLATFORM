# Copy this file to .env and fill in your own values. NEVER commit .env or paste it in chat.

# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# public address of the site (used in emails and portal links)
SITE_URL=http://127.0.0.1:8000

# ---- Branding (client portal, emails, PDF reports) ----
BRAND_NAME=Order Platform
BRAND_COLOR=#4f46e5
# used to build WhatsApp links (0300... becomes 92300...)
DEFAULT_COUNTRY_CODE=92

# ---- YouTube Data API v3 ----
YOUTUBE_API_KEY=

# ---- Google OAuth ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/google-accounts/callback/

# ---- Encryption keys (generate each with the command below) ----
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# ---- Monitoring defaults (can also be changed later on the Settings screen) ----
MONITORING_INTERVAL_MINUTES=60
MONITORING_RETRY_BASE_MINUTES=5
MONITORING_MAX_FAILURES=5
REVIEW_OVERDUE_HOURS=24

# ---- Backups ----
BACKUP_DIR=backups
BACKUP_KEEP=14

# ---- Production hardening ----
# change to something private in production
ADMIN_URL=admin/
# CSRF_TRUSTED_ORIGINS=https://orders.example.com
# TRUST_PROXY_HEADERS=True            # only behind Nginx/Cloudflare
# HSTS_SECONDS=0                      # raise once HTTPS works

# ---- Email (weekly client reports). Default prints emails to the console. ----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=                # use an app password, not your normal password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Order Platform <you@example.com>

# ---- WhatsApp Business Cloud API (optional automatic messages; see README) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=weekly_progress_report
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# ---- Client portal ----
# show the "estimate" line to clients (False hides it)
PORTAL_SHOW_ETA=True

# ---- Two-factor authentication ----
# True = every user must set up an authenticator app
REQUIRE_2FA=False

# ---- AI (optional; everything also works without it) ----
# Use ONE provider. Leave AI_PROVIDER empty to use whichever key is filled in.
# AI_PROVIDER=gemini
# Google Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Anthropic Claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# AI calls per user per hour
AI_HOURLY_LIMIT=30

# ---- Database (empty = SQLite). PostgreSQL on the server: filled by deploy/deploy.sh ----
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# USE_HTTPS=False    # only for plain-http servers without a domain
